{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Foundry Local: Start",
      "type": "shell",
      "command": "docker compose -f compose.foundry.yaml up --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Foundry Local: Stop",
      "type": "shell",
      "command": "docker compose -f compose.foundry.yaml down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
